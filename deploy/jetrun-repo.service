[Unit]
Description=jetrun Repo Service
After=network.target postgresql.service nats.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/jetrun
ExecStart=/opt/jetrun/bin/jetrun-repo
Restart=on-failure
RestartSec=3
StartLimitBurst=5
StartLimitIntervalSec=60

Environment=RUST_LOG=info
Environment=DATABASE_URL=postgres://jetrun:jetrun_dev@localhost:5432/jetrun
Environment=NATS_URL=nats://localhost:4222

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/jetrun/data
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

LimitNOFILE=65535
LimitNPROC=4096

StandardOutput=journal
StandardError=journal
SyslogIdentifier=jetrun-repo

[Install]
WantedBy=multi-user.target
