[Unit]
Description=jetrun Build Worker
After=network.target postgresql.service nats.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/jetrun
ExecStart=/opt/jetrun/bin/jetrun-worker
Restart=on-failure
RestartSec=3
StartLimitBurst=5
StartLimitIntervalSec=60

Environment=RUST_LOG=info
Environment=DATABASE_URL=postgres://jetrun:jetrun_dev@localhost:5432/jetrun
Environment=NATS_URL=nats://localhost:4222
Environment=HOME=/opt/jetrun/data/home
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/go/bin:/opt/jetrun/data/home/go/bin
Environment=GOPATH=/opt/jetrun/data/home/go
Environment=GOMODCACHE=/opt/jetrun/data/home/go/pkg/mod

# Hardening — relaxed enough for namespace isolation + build tools
ProtectSystem=full
ReadWritePaths=/opt/jetrun/data
PrivateTmp=true

# Allow user namespace creation for build isolation
AmbientCapabilities=CAP_SYS_ADMIN
NoNewPrivileges=false

LimitNOFILE=65535
LimitNPROC=4096

StandardOutput=journal
StandardError=journal
SyslogIdentifier=jetrun-worker

[Install]
WantedBy=multi-user.target
